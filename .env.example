# Required
SECRET_KEY=generate-a-random-64-char-string-here

# Postgres connection string (e.g. Neon pooled connection)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Ollama (already configured for your cloud)
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gemma3:27b
OLLAMA_API_KEY=your-key-here

# Microsoft Entra ID SSO (optional - for SSO with vicit.com domain)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=
# MICROSOFT_ALLOWED_DOMAIN=vicit.com

# Google reCAPTCHA v3 (optional - protects password login)
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=

# S3-compatible object storage for uploads / processed files (optional)
# AWS_ENDPOINT_URL_S3=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=csv-upload
